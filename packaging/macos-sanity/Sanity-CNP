#!/bin/zsh

set -u

SCRIPT_DIR="${0:A:h}"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
PYTHON_HINT_FILE="$SCRIPT_DIR/../Resources/python-path"
BUILD_PYTHON=""
LOG_DIR="$HOME/Library/Logs/CNP-Function-Explorer"
CACHE_DIR="$HOME/Library/Caches/CNP-Function-Explorer/matplotlib"

/bin/mkdir -p "$LOG_DIR" "$CACHE_DIR"

if [[ -f "$PYTHON_HINT_FILE" ]]; then
    IFS= read -r BUILD_PYTHON < "$PYTHON_HINT_FILE"
fi

if [[ -n "${CNP_PYTHON:-}" && -x "${CNP_PYTHON:-}" ]]; then
    PYTHON="$CNP_PYTHON"
elif [[ -x "$PROJECT_ROOT/.venv/bin/python" ]]; then
    PYTHON="$PROJECT_ROOT/.venv/bin/python"
elif [[ -n "$BUILD_PYTHON" && -x "$BUILD_PYTHON" ]]; then
    PYTHON="$BUILD_PYTHON"
else
    PYTHON="$(/usr/bin/which python3 2>/dev/null || true)"
fi

if [[ ! -x "$PYTHON" ]]; then
    /usr/bin/osascript -e 'display alert "CNP Function Explorer" message "Python環境が見つかりません。.venvを作成するか、CNP_PYTHONを設定してください。" as critical'
    exit 1
fi

if [[ ! -f "$PROJECT_ROOT/apps/sanity_desktop.py" ]]; then
    /usr/bin/osascript -e 'display alert "CNP Function Explorer" message "プロジェクトが見つかりません。.appはリポジトリ内のdistフォルダーから起動してください。" as critical'
    exit 1
fi

export PYTHONPATH="$PROJECT_ROOT/src"
export PYTHONNOUSERSITE=1
export MPLCONFIGDIR="$CACHE_DIR"
export PATH="${PYTHON:h}:/usr/bin:/bin:/usr/sbin:/sbin"

cd "$PROJECT_ROOT" || exit 1

# Match the Python entry point's import order: TkAgg must be initialized before
# importing the CNP runtime/PyTorch in this environment.
if ! "$PYTHON" -c 'import tkinter; import matplotlib; matplotlib.use("TkAgg"); from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg; from cnp.sanity_demo import SanityDemoRuntime; from cnp.rbf_gp_demo import RBFGPDemoRuntime' >>"$LOG_DIR/app.log" 2>&1; then
    /usr/bin/osascript -e 'display alert "CNP Function Explorer" message "必要なPythonライブラリを読み込めませんでした。ログを確認してください: ~/Library/Logs/CNP-Function-Explorer/app.log" as critical'
    exit 1
fi

exec "$PYTHON" "$PROJECT_ROOT/apps/sanity_desktop.py" >>"$LOG_DIR/app.log" 2>&1
